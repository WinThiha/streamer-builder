# Customer production environment — copy to .env and edit before install

# Public hostname (DNS A/AAAA must point to this server)
DOMAIN=stream.example.com

# Let's Encrypt contact (recommended for TLS)
ACME_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_USER=movie
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=movie_streamer

# API session signing (min 32 random characters)
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# Optional: pre-seed TMDB key via env instead of /setup (usually leave empty)
TMDB_API_KEY=

# Container images (defaults shown; override for your registry)
API_IMAGE=ghcr.io/example/movie-streamer-api
WEB_IMAGE=ghcr.io/example/movie-streamer-web
IMAGE_TAG=latest

# Secure cookies when served over HTTPS
COOKIE_SECURE=true
