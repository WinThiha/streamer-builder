# Copy to .env and adjust for local development

# PostgreSQL (matches docker-compose.dev.yml defaults)
DATABASE_URL=postgresql://movie:movie@localhost:5432/movie_streamer

# production = customer single-tenant site; prototype = vendor demo (Phase 5)
APP_MODE=production

# API
PORT=3001
NODE_ENV=development

# Auth placeholder (Phase 2+)
JWT_SECRET=change-me-in-production

# TMDB metadata (Phase 1+)
TMDB_API_KEY=

# Web — leave empty to use Vite /api proxy to API
VITE_API_URL=

# Vite dev proxy target (Docker sets http://api:3001)
VITE_PROXY_API_TARGET=http://localhost:3001
