# Copy to .env and adjust for local development

# PostgreSQL (matches docker-compose.dev.yml defaults)
DATABASE_URL=postgresql://movie:movie@localhost:5432/movie_streamer

# production = customer single-tenant site; prototype = vendor demo (Phase 5)
APP_MODE=production

# API
PORT=3001
NODE_ENV=development

# Session signing (required in production; min 32 chars)
SESSION_SECRET=dev-session-secret-change-me-in-production-min-32-chars

# Skip admin login in local dev when true (never use in production)
ADMIN_AUTH_DISABLED=true

# TMDB metadata — optional at boot if using /setup; required for catalog when not using setup wizard
TMDB_API_KEY=

# Optional path to import site.config.yaml during setup
# SITE_CONFIG_BOOTSTRAP_PATH=./site.config.yaml

# Set true when serving over HTTPS in dev (production compose sets via env)
COOKIE_SECURE=false

# Legal demo HLS stream for Phase 1 playback (optional; Apple sample used if unset)
# DEMO_HLS_URL=https://devstreaming-cdn.apple.com/videos/streaming/examples/img_bipbop_adv_example_ts/master.m3u8

# Site branding uploads (Phase 3)
UPLOAD_DIR=./data/uploads
MAX_LOGO_BYTES=2097152

# Web — leave empty to use Vite /api proxy to API
VITE_API_URL=

# Vite dev proxy target (Docker sets http://api:3001)
VITE_PROXY_API_TARGET=http://localhost:3001
